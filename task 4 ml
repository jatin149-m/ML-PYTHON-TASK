import pandas as pd
df = pd.read_csv('/content/Dataset .csv')
print(df.info())
print(df.isnull().sum())
df.dropna(subset=['Latitude', 'Longitude'], inplace=True) 
df.drop_duplicates(inplace=True)  
pip install folium plotly
import folium
avg_Latitude = df['Latitude'].mean()
avg_Longitude = df['Longitude'].mean()
map = folium.Map(location=[avg_Latitude, avg_Longitude], zoom_start=12)
for index, row in df.iterrows():
    folium.Marker(
        location=[row['Latitude'], row['Longitude']],
        popup=row['Restaurant Name']  
    ).add_to(map)
map.save('restaurants_map.html')
grouped = df.groupby('City').size().reset_index(name='restaurant_count')
print(grouped.sort_values(by='restaurant_count', ascending=False))
import seaborn as sns
import matplotlib.pyplot as plt
plt.figure(figsize=(18, 8))
sns.barplot(data=grouped, x='City', y='restaurant_count')
plt.xticks(rotation=90)
plt.title('Restaurant Concentration by City')
plt.show()
avg_Pricerange = df.groupby('City')['Price range'].mean().reset_index(name='avg_Price range')
print(avg_Pricerange.sort_values(by='avg_Price range', ascending=False))
from collections import Counter
def most_common_Cuisine(Cuisines):
    return Counter(Cuisines).most_common(1)[0][0]
common_Cuisines = df.groupby('City')['Cuisines'].apply(lambda x: most_common_Cuisine(x)).reset_index(name='most_common_Cuisines')
print(common_Cuisines)
avg_prices = df.groupby('City')['Price range'].mean().reset_index(name='avg_Price range')
print(avg_prices)
sns.scatterplot(data=df, x='Rating color', y='Price range', hue='City')
plt.title('Rating color vs Price Range by City')
