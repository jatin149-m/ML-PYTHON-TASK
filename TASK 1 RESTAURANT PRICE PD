import pandas as pd
df = pd.read_csv('/content/Dataset .csv')
print(df.head())
df.fillna(df.select_dtypes(include=['number']).mean(), inplace=True)
df.fillna(df.select_dtypes(include=['object']).mode().iloc[0], inplace=True)
from sklearn.preprocessing import LabelEncoder
label_encoder = LabelEncoder()
df['Restaurant Name'] = label_encoder.fit_transform(df['Country Code'])
df = pd.get_dummies(df, columns=['Restaurant Name'], drop_first=True)
X = df.drop('Restaurant ID', axis=1)
y = df['Country Code']
categorical_cols = df.select_dtypes(include=['object']).columns
print("Categorical Columns:", categorical_cols)
from sklearn.preprocessing import LabelEncoder
label_encoder = LabelEncoder()
for col in categorical_cols:
    df[col] = label_encoder.fit_transform(df[col])
df = pd.get_dummies(df, columns=categorical_cols, drop_first=True)
print(df.dtypes)
from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.80, random_state=4200)
from sklearn.tree import DecisionTreeRegressor
model = DecisionTreeRegressor(random_state=4200)
model.fit(X_train, y_train)
from sklearn.metrics import mean_squared_error, r2_score
y_pred = model.predict(X_test)
mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
print(f"Mean Squared Error: {mse}")
print(f"R-squared: {r2}")
feature_importance = model.feature_importances_
importance_df = pd.DataFrame({'Feature': X.columns, 'Importance': feature_importance})
importance_df = importance_df.sort_values(by='Importance', ascending=False)
print(importance_df)
import matplotlib.pyplot as plt
plt.scatter(y_test, y_pred)
plt.xlabel('Actual Ratings')
plt.ylabel('Predicted Ratings')
plt.title('Actual vs Predicted Ratings')
plt.show()
import joblib
joblib.dump(model, 'restaurant_rating_model.pkl')

